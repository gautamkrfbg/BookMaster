@model CreateExchangeRequestVm
<h1>New Exchange Request</h1>
<div asp-validation-summary="All" class="error"></div>
<form method="post">
    @Html.AntiForgeryToken()
    <label>Listing</label>
    <select asp-for="ListingId">
        @foreach (var l in (ViewBag.Listings as List<ExchangeListingVm>) ?? new List<ExchangeListingVm>())
        {
            <option value="@l.Id">Listing #@l.Id (wants @l.WantedType)</option>
        }
    </select><br />
    <label>Offered Book</label>
    <select asp-for="OfferedBookId">
        @foreach (var b in (ViewBag.Books as List<BookVm>) ?? new List<BookVm>())
        {
            <option value="@b.Id">@b.Title</option>
        }
    </select><br />
    <button type="submit">Send Request</button>
</form>