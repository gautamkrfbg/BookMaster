@model CreateExchangeListingVm
<h1>New Exchange Listing</h1>
<div asp-validation-summary="All" class="error"></div>
<form method="post">
    @Html.AntiForgeryToken()
    <label>Book</label>
    <select asp-for="BookId">
        @foreach (var b in (ViewBag.Books as List<BookVm>) ?? new List<BookVm>())
        {
            <option value="@b.Id">@b.Title</option>
        }
    </select><br />
    <label>Wanted Type</label>
    <input asp-for="WantedType" /><br />
    <button type="submit">Create</button>
</form>